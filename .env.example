# Server Port
PORT=3000

# Database Connection (PostgreSQL with pgvector)
# Replace with your local or Neon PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/ragagent?sslmode=disable"

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# OpenRouter API Key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"

# Active Default AI Provider: groq | gemini | openrouter
AI_PROVIDER="groq"

# Custom Model Subselections
GROQ_MODEL="llama-3.1-8b-instant"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
GEMINI_MODEL="gemini-1.5-flash"
